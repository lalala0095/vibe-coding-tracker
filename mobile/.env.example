# Copy to `.env` and fill in. Both values are also set as EAS build env vars.
#
# Everything with an `EXPO_PUBLIC_` prefix is inlined into the JS bundle at build
# time, so it ships inside the APK and anyone can read it. That is fine for these
# two and only these two: both are already public in the web bundle at
# `front/` — the API is a public Cloud Run URL guarded by a bearer token, and an
# OAuth *client ID* is public by design (the client *secret* is not, and is not
# used here).
#
# Nothing from `back/.env.deploy` belongs in this file or anywhere under
# `mobile/`. Not SECRET_KEY, not the service account, not the Firestore
# credentials. If a value would be dangerous printed on a billboard, it does not
# go in a mobile build.

# The Cloud Run base URL of the FastAPI backend, no trailing slash.
EXPO_PUBLIC_API_URL=https://your-api-host.example.run.app

# The **web** OAuth client ID — the same GOOGLE_CLIENT_ID the backend verifies
# against. Not an Android client ID: the Android client must exist in the GCP
# project for the native handshake to succeed, but it is never named in code.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
