# Written before any source exists, deliberately: nothing secret or generated
# should ever have a chance to reach a commit.

# Secrets — never commit, never read, never print
.env
.env.*
!.env.example
google-services.json
serviceAccountKey.json
*.keystore
*.jks

# Dependencies
node_modules/

# Expo / EAS
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects — generated by prebuild, not source of truth
/android
/ios

# Build artefacts
*.apk
*.aab
*.tar.gz

# Tooling droppings — Metro and tsc write these into the repo root
.metro-health-check*
*.tsbuildinfo

# Editor / OS
.DS_Store
*.log
.vscode/
.idea/
