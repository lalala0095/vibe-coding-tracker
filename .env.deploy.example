# ---------------------------------------------------------------------------
# Deployment config for deploy.sh
# Copy this file to .env.deploy and fill in your values.
# .env.deploy is git-ignored — never commit it.
# ---------------------------------------------------------------------------

# GCP project where Cloud Run will be deployed
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google OAuth2 Client ID (from GCP Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com

# Secret key for signing session JWTs — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key

# Session duration in days
SESSION_EXPIRY_DAYS=7

# Firestore database name (use "(default)" if you didn't create a named database)
FIRESTORE_DATABASE=for-my-vibe-coding-tracker

# GCS bucket name for file attachments
GCS_BUCKET_NAME=your-gcs-bucket-name

# Comma-separated allowed CORS origins (your Vercel frontend URL)
CORS_ORIGINS=https://your-app.vercel.app

# Cloud Run service name (default is fine)
SERVICE_NAME=vibe-coding-tracker-api

# Deployment region (asia-southeast1 = Singapore)
REGION=asia-southeast1

# Cloud Run scaling
MIN_INSTANCES=0
MAX_INSTANCES=10

# Cloud Run resources
MEMORY=512Mi
CPU=1
